# Optional frontend API base URL override.
# If unset, the app falls back to: http://localhost:8000/api/v1
#
# Set this when:
# - your backend runs on a different host/port
# - you prefer 127.0.0.1 over localhost
# - you point frontend to a remote/dev backend
# - you want to bypass the default Cloudflare Worker edge proxy in deployed builds
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional Sentry dashboard observability.
# Leave VITE_SENTRY_DSN blank to keep local development inert.
VITE_SENTRY_DSN=
# Optional explicit environment override. Defaults to the current Vite mode.
VITE_SENTRY_ENVIRONMENT=
# Use the same release value across backend/frontend when release tracking is wired.
VITE_SENTRY_RELEASE=
# Trace sampling rate between 0 and 1. Use 0 to disable browser tracing.
VITE_SENTRY_TRACES_SAMPLE_RATE=0
# Optional build-time source-map upload variables. These are read by Vite at
# build time, not by browser runtime code. If any are blank, the app still
# builds and emits sourcemaps locally, but no Sentry upload runs.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Supabase auth client config (required for login flow)
# The anon key is safe for client-side use; do not put service-role keys here.
# Example URL: https://your-project-ref.supabase.co
# These are also required when using the web app to obtain a real JWT session
# for local extension runtime testing.
# In Cloudflare Workers/Vite deploys, set these as project environment variables instead of
# committing populated values to source control.
# Google sign-in also requires provider enablement + redirect allow-list setup.
# See docs/google-auth-setup-matrix.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
