# Production environment reference for Cloudflare Pages.
# Prefer setting these values in the Pages dashboard.
# If you want a local production build preview, copy this file to
# `frontend/.env.production` and replace the placeholders.

# Optional browser-side API override.
# Leave this unset to use the same-origin Cloudflare Worker edge proxy at `/api/v1`.
# Only set it if you intentionally want the browser to call Render directly.
# VITE_API_BASE_URL=https://your-render-service.onrender.com/api/v1

# Optional Sentry dashboard observability.
VITE_SENTRY_DSN=https://[YOUR-KEY]@[YOUR-SENTRY-HOST]/[YOUR-PROJECT-ID]
# Optional explicit override. Defaults to the production Vite mode when blank.
# VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=frontend@2026-04-20
# Start deliberately to avoid noisy browser traces. Use 0 to disable tracing.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional build-time source-map upload variables for readable production stack
# traces. Set these in the Pages/CI build environment. If any are unset, the
# build still succeeds and still emits sourcemaps, but no upload occurs.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Supabase browser auth configuration.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key is safe for client-side use, but keep real values in
# Cloudflare Workers/Vite environment variables instead of committing them.
# The Worker runtime variable `API_BACKEND_ORIGIN` belongs in Cloudflare
# Workers configuration, not in this Vite env file.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
